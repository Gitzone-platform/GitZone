generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String  @id @default(cuid())
  username  String  @unique
  email     String  @unique
  password  String
  name      String?
  avatarUrl String?
  bio       String?
  location  String?
  website   String?

  sessions                         Session[]
  repositories                     Repository[]
  stars                            RepositoryStar[]
  watches                          RepositoryWatch[]
  personalAccessTokens             PersonalAccessToken[]
  repositoryCollaborations         RepositoryCollaborator[]
  twoFactorAuthentication          TwoFactorAuthentication?
  recoveryCodes                    RecoveryCode[]
  twoFactorChallenges              TwoFactorChallenge[]
  pullRequestsAuthored             PullRequest[]              @relation("PullRequestAuthor")
  pullRequestsMerged               PullRequest[]              @relation("PullRequestMergedBy")
  pullRequestReviews               PullRequestReview[]        @relation("PullRequestReviewer")
  pullRequestComments              PullRequestReviewComment[] @relation("PullRequestCommentAuthor")
  pullRequestConversationsResolved PullRequestConversation[]  @relation("PullRequestConversationResolvedBy")
  issuesCreated                    Issue[]                    @relation("IssueCreator")
  issueComments                    IssueComment[]             @relation("IssueCommentAuthor")
  issueAssignments                 IssueAssignee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TwoFactorAuthentication {
  id               String    @id @default(cuid())
  userId           String    @unique
  encryptedSecret  String
  enabledAt        DateTime?
  lastUsedTotpStep BigInt?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TwoFactorChallenge {
  id        String @id @default(cuid())
  userId    String
  tokenHash String @unique

  expiresAt    DateTime
  usedAt       DateTime?
  attemptCount Int       @default(0)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model RecoveryCode {
  id       String    @id @default(cuid())
  userId   String
  codeHash String
  usedAt   DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @unique
  refreshTokenJti  String    @unique
  tokenFamilyId    String
  parentSessionId  String?
  replacedById     String?   @unique
  userAgent        String?
  ipAddress        String?
  lastUsedAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  rotatedAt        DateTime?
  reuseDetectedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  parentSession Session?  @relation("SessionRotation", fields: [parentSessionId], references: [id], onDelete: SetNull)
  childSessions Session[] @relation("SessionRotation")

  replacedBy      Session? @relation("SessionReplacement", fields: [replacedById], references: [id], onDelete: SetNull)
  replacedSession Session? @relation("SessionReplacement")

  @@index([userId])
  @@index([expiresAt])
  @@index([tokenFamilyId])
  @@index([parentSessionId])
}

model PersonalAccessToken {
  id          String    @id @default(cuid())
  userId      String
  name        String
  tokenPrefix String    @unique
  tokenHash   String    @unique
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Repository {
  labels     Label[]
  milestones Milestone[]

  id            String  @id @default(cuid())
  ownerId       String
  name          String
  description   String?
  isPrivate     Boolean @default(false)
  defaultBranch String  @default("main")
  forkedFromId  String?

  forkedFrom Repository?  @relation("RepositoryForks", fields: [forkedFromId], references: [id], onDelete: SetNull)
  forks      Repository[] @relation("RepositoryForks")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  collaborators RepositoryCollaborator[]
  stars         RepositoryStar[]
  watches       RepositoryWatch[]
  pullRequests  PullRequest[]
  issues        Issue[]
  issueCounter  RepositoryIssueCounter?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerId, name])
  @@index([ownerId])
  @@index([forkedFromId])
}

enum RepositoryPermission {
  READ
  WRITE
}

model RepositoryCollaborator {
  id           String               @id @default(cuid())
  repositoryId String
  userId       String
  permission   RepositoryPermission @default(READ)

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([repositoryId, userId])
  @@index([repositoryId])
  @@index([userId])
}

enum PullRequestState {
  OPEN
  CLOSED
  MERGED
}

model PullRequest {
  labels      PullRequestLabel[]
  milestoneId String?
  milestone   Milestone?         @relation(fields: [repositoryId, milestoneId], references: [repositoryId, id], onDelete: NoAction, onUpdate: NoAction)

  id           String @id @default(cuid())
  repositoryId String
  number       Int
  authorId     String

  title       String
  description String?

  sourceBranch String
  targetBranch String

  state PullRequestState @default(OPEN)

  mergedAt   DateTime?
  mergedById String?
  mergeSha   String?

  repository    Repository                @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  author        User                      @relation("PullRequestAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  mergedBy      User?                     @relation("PullRequestMergedBy", fields: [mergedById], references: [id], onDelete: SetNull)
  reviews       PullRequestReview[]
  conversations PullRequestConversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([repositoryId, number])
  @@index([repositoryId, state])
  @@index([repositoryId, sourceBranch, targetBranch, state])
  @@index([authorId])
  @@index([mergedById])
}

enum PullRequestReviewState {
  COMMENTED
  APPROVED
  CHANGES_REQUESTED
}

enum PullRequestConversationType {
  GENERAL
  INLINE
}

enum PullRequestDiffSide {
  LEFT
  RIGHT
}

model PullRequestReview {
  id            String                 @id @default(cuid())
  pullRequestId String
  reviewerId    String
  state         PullRequestReviewState
  body          String?
  headSha       String

  pullRequest PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  reviewer    User        @relation("PullRequestReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)

  comments PullRequestReviewComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pullRequestId])
  @@index([pullRequestId, reviewerId])
  @@index([pullRequestId, state])
  @@index([reviewerId])
}

model PullRequestConversation {
  id            String                      @id @default(cuid())
  pullRequestId String
  type          PullRequestConversationType

  path    String?
  line    Int?
  side    PullRequestDiffSide?
  baseSha String?
  headSha String?

  resolvedAt   DateTime?
  resolvedById String?

  pullRequest PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  resolvedBy  User?       @relation("PullRequestConversationResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  comments PullRequestReviewComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pullRequestId])
  @@index([pullRequestId, type])
  @@index([pullRequestId, resolvedAt])
  @@index([resolvedById])
}

model PullRequestReviewComment {
  id             String  @id @default(cuid())
  conversationId String
  authorId       String
  reviewId       String?

  body String

  conversation PullRequestConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User                    @relation("PullRequestCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  review       PullRequestReview?      @relation(fields: [reviewId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([conversationId])
  @@index([authorId])
  @@index([reviewId])
}

enum IssueState {
  OPEN
  CLOSED
}

model RepositoryIssueCounter {
  repositoryId String @id
  nextNumber   Int    @default(1)

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
}

model Issue {
  labels      IssueLabel[]
  milestoneId String?
  milestone   Milestone?   @relation(fields: [repositoryId, milestoneId], references: [repositoryId, id], onDelete: NoAction, onUpdate: NoAction)

  id           String @id @default(cuid())
  repositoryId String
  number       Int
  creatorId    String

  title String
  body  String?

  state    IssueState @default(OPEN)
  closedAt DateTime?

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  creator    User       @relation("IssueCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  comments  IssueComment[]
  assignees IssueAssignee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([repositoryId, number])
  @@index([repositoryId, state])
  @@index([creatorId])
}

model IssueComment {
  id       String @id @default(cuid())
  issueId  String
  authorId String

  body String

  issue  Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author User  @relation("IssueCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([issueId, createdAt])
  @@index([authorId])
}

model IssueAssignee {
  issueId String
  userId  String

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([issueId, userId])
  @@index([userId])
}

enum MilestoneState {
  OPEN
  CLOSED
}

model Label {
  id           String  @id @default(cuid())
  repositoryId String
  name         String
  color        String
  description  String?

  repository   Repository         @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  issues       IssueLabel[]
  pullRequests PullRequestLabel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([repositoryId, name])
  @@index([repositoryId])
}

model IssueLabel {
  issueId String
  labelId String

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([issueId, labelId])
  @@index([labelId])
}

model PullRequestLabel {
  pullRequestId String
  labelId       String

  pullRequest PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  label       Label       @relation(fields: [labelId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([pullRequestId, labelId])
  @@index([labelId])
}

model Milestone {
  id           String  @id @default(cuid())
  repositoryId String
  title        String
  description  String?

  state    MilestoneState @default(OPEN)
  dueDate  DateTime?
  closedAt DateTime?

  repository   Repository    @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  issues       Issue[]
  pullRequests PullRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([repositoryId, title])
  @@unique([repositoryId, id])
  @@index([repositoryId, state])
  @@index([dueDate])
}

model RepositoryStar {
  id           String   @id @default(cuid())
  userId       String
  repositoryId String
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([userId, repositoryId])
  @@index([repositoryId])
}

enum RepositoryWatchPreference {
  ALL
  PARTICIPATING
  IGNORE
}

model RepositoryWatch {
  id           String                    @id @default(cuid())
  userId       String
  repositoryId String
  createdAt    DateTime                  @default(now())
  preference   RepositoryWatchPreference @default(ALL)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([userId, repositoryId])
  @@index([repositoryId])
}
